# Copy to .env for local use. Never commit .env or real credentials.
# All API keys and passwords are intentionally empty.

SPRING_PROFILES_ACTIVE=local
SUPPORTFORGE_INSTANCE_ID=local-instance
SUPPORTFORGE_PORT=7000

SUPPORTFORGE_LLM_PROVIDER=mock
SUPPORTFORGE_LLM_MODEL=mock-v1
SUPPORTFORGE_LLM_THINKING_MODE=
SUPPORTFORGE_LLM_CHAT_MAX_TOKENS=4096
SUPPORTFORGE_LLM_SPECIALIST_MAX_TOKENS=2048
SUPPORTFORGE_LLM_INTENT_MAX_TOKENS=1024
SUPPORTFORGE_LLM_JUDGE_MAX_TOKENS=2048
SUPPORTFORGE_MEMORY_SUMMARY_MAX_TOKENS=1024
SUPPORTFORGE_LLM_CONNECT_TIMEOUT=10s
SUPPORTFORGE_LLM_READ_TIMEOUT=120s
SUPPORTFORGE_LLM_CHAT_URL=http://localhost:11434/v1/chat/completions
SUPPORTFORGE_LLM_API_KEY=

SUPPORTFORGE_EMBEDDING_PROVIDER=mock
SUPPORTFORGE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
SUPPORTFORGE_EMBEDDING_MODEL_VERSION=qwen3-embedding-v1
SUPPORTFORGE_EMBEDDING_ENDPOINT=http://localhost:8000/v1/embeddings
SUPPORTFORGE_EMBEDDING_API_KEY=
SUPPORTFORGE_EMBEDDING_DIMENSIONS=1024
SUPPORTFORGE_EMBEDDING_BATCH_SIZE=10
SUPPORTFORGE_EMBEDDING_TIMEOUT=30s
SUPPORTFORGE_EMBEDDING_NORMALIZE=true

SUPPORTFORGE_QDRANT_PROVIDER=memory
SUPPORTFORGE_QDRANT_ENDPOINT=http://localhost:6333
SUPPORTFORGE_QDRANT_API_KEY=
SUPPORTFORGE_QDRANT_COLLECTION=supportforge_knowledge_v1
SUPPORTFORGE_QDRANT_DENSE_VECTOR_NAME=qwen3_dense
SUPPORTFORGE_QDRANT_INDEX_VERSION=knowledge-qwen3-v1
SUPPORTFORGE_QDRANT_DIMENSIONS=1024
SUPPORTFORGE_QDRANT_DISTANCE=Cosine
SUPPORTFORGE_RETRIEVAL_CANDIDATE_LIMIT=100
SUPPORTFORGE_RETRIEVAL_DEFAULT_LIMIT=8
SUPPORTFORGE_RETRIEVAL_MAXIMUM_LIMIT=50
SUPPORTFORGE_RETRIEVAL_RRF_K=60
SUPPORTFORGE_RERANKER_PROVIDER=mock
SUPPORTFORGE_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
SUPPORTFORGE_RERANKER_MODEL_VERSION=qwen3-reranker-v1
SUPPORTFORGE_RERANKER_ENDPOINT=http://localhost:8001/v1/rerank
SUPPORTFORGE_RERANKER_API_KEY=
SUPPORTFORGE_RERANKER_BATCH_SIZE=32
SUPPORTFORGE_RERANKER_CANDIDATE_LIMIT=30
SUPPORTFORGE_RERANKER_MINIMUM_SCORE=0.0
SUPPORTFORGE_RERANKER_TIMEOUT=20s
SUPPORTFORGE_RERANKER_FAIL_OPEN=true
SUPPORTFORGE_GROUNDING_MAXIMUM_EVIDENCE=5
SUPPORTFORGE_GROUNDING_MINIMUM_EVIDENCE=1
SUPPORTFORGE_GROUNDING_MINIMUM_RERANK_SCORE=0.12
SUPPORTFORGE_GROUNDING_MINIMUM_QUERY_COVERAGE=0.30
SUPPORTFORGE_QDRANT_SHARD_NUMBER=1
SUPPORTFORGE_QDRANT_REPLICATION_FACTOR=1
SUPPORTFORGE_QDRANT_WRITE_CONSISTENCY_FACTOR=1
SUPPORTFORGE_QDRANT_UPSERT_BATCH_SIZE=64
SUPPORTFORGE_QDRANT_TIMEOUT=10s

SUPPORTFORGE_OUTBOX_CLAIM_BATCH_SIZE=50
SUPPORTFORGE_OUTBOX_LEASE_DURATION=30s
SUPPORTFORGE_OUTBOX_MAXIMUM_ATTEMPTS=10
SUPPORTFORGE_OUTBOX_INITIAL_RETRY_DELAY=1s
SUPPORTFORGE_OUTBOX_MAXIMUM_RETRY_DELAY=5m

SUPPORTFORGE_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
SUPPORTFORGE_KAFKA_KNOWLEDGE_TOPIC=supportforge.knowledge.index.v1
SUPPORTFORGE_KAFKA_DLT_TOPIC=supportforge.knowledge.index.v1.dlt
SUPPORTFORGE_KAFKA_CONSUMER_GROUP=supportforge-knowledge-indexer-v1
SUPPORTFORGE_KAFKA_PARTITIONS=6
SUPPORTFORGE_KAFKA_REPLICATION_FACTOR=1
SUPPORTFORGE_KAFKA_OUTBOX_POLL_DELAY=1s
SUPPORTFORGE_KAFKA_SEND_TIMEOUT=10s
SUPPORTFORGE_KAFKA_CONSUMER_RETRY_DELAY=2s
SUPPORTFORGE_KAFKA_CONSUMER_MAXIMUM_ATTEMPTS=5
SUPPORTFORGE_KAFKA_WORKER_LEASE_DURATION=2m

SUPPORTFORGE_FEATURE_POSTGRES_PERSISTENCE=false
SUPPORTFORGE_FEATURE_QDRANT_RETRIEVAL=false
SUPPORTFORGE_FEATURE_OBJECT_STORAGE=false
SUPPORTFORGE_FEATURE_KAFKA_INDEXING=false
SUPPORTFORGE_FEATURE_DISTRIBUTED_CACHE=false
SUPPORTFORGE_FEATURE_MULTI_TENANCY=false
SUPPORTFORGE_FEATURE_GROUNDING_HARNESS=false

SUPPORTFORGE_POSTGRES_URL=jdbc:postgresql://localhost:5432/supportforge
SUPPORTFORGE_POSTGRES_USERNAME=supportforge
SUPPORTFORGE_POSTGRES_PASSWORD=
SUPPORTFORGE_POSTGRES_SCHEMA=supportforge
SUPPORTFORGE_PERSISTENCE_MEMORY=json
SUPPORTFORGE_PERSISTENCE_FEEDBACK=json
SUPPORTFORGE_PERSISTENCE_EVALUATION=json
SUPPORTFORGE_POSTGRES_MAXIMUM_POOL_SIZE=20
SUPPORTFORGE_POSTGRES_MINIMUM_IDLE=2
SUPPORTFORGE_POSTGRES_CONNECTION_TIMEOUT=5s
SUPPORTFORGE_POSTGRES_MIGRATION_ENABLED=true

SUPPORTFORGE_PERSISTENCE_INTENT_LEARNING=json
SUPPORTFORGE_PERSISTENCE_KNOWLEDGE=json
SUPPORTFORGE_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

SUPPORTFORGE_OBJECT_STORAGE_PROVIDER=filesystem
SUPPORTFORGE_OBJECT_STORAGE_FILESYSTEM_ROOT=data/object-storage
SUPPORTFORGE_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
SUPPORTFORGE_OBJECT_STORAGE_ACCESS_KEY=
SUPPORTFORGE_OBJECT_STORAGE_SECRET_KEY=
SUPPORTFORGE_OBJECT_STORAGE_BUCKET=supportforge-knowledge
SUPPORTFORGE_OBJECT_STORAGE_REGION=us-east-1
SUPPORTFORGE_OBJECT_STORAGE_AUTO_CREATE_BUCKET=true

SUPPORTFORGE_KNOWLEDGE_MAXIMUM_CHUNK_CHARS=800
SUPPORTFORGE_KNOWLEDGE_MINIMUM_CHUNK_CHARS=120
SUPPORTFORGE_KNOWLEDGE_CHUNK_OVERLAP_CHARS=120
SUPPORTFORGE_KNOWLEDGE_PARSER_VERSION=text-clean-v1
SUPPORTFORGE_KNOWLEDGE_CHUNKER_VERSION=stable-boundary-v1

SUPPORTFORGE_VALKEY_PASSWORD=
SUPPORTFORGE_KAFKA_PASSWORD=

SUPPORTFORGE_MEMORY_EPISODE_MAX_RESULTS=3
SUPPORTFORGE_MEMORY_EPISODE_MINIMUM_SCORE=0.15
SUPPORTFORGE_VALKEY_URI=redis://localhost:6379
SUPPORTFORGE_CACHE_MAXIMUM_ENTRIES=10000
SUPPORTFORGE_CACHE_L1_TTL=30s
SUPPORTFORGE_CACHE_L2_TTL=10m
SUPPORTFORGE_CACHE_NAMESPACE=supportforge:v1
SUPPORTFORGE_DEPENDENCY_TIMEOUT=2s
SUPPORTFORGE_CIRCUIT_FAILURE_THRESHOLD=3
SUPPORTFORGE_CIRCUIT_OPEN_DURATION=10s
SUPPORTFORGE_MAXIMUM_CONCURRENT_CALLS=50
SUPPORTFORGE_RATE_LIMIT_REQUESTS=100
SUPPORTFORGE_RATE_LIMIT_WINDOW=1m
SUPPORTFORGE_TRACING_SAMPLE_PROBABILITY=0.10
SUPPORTFORGE_OTLP_TRACING_ENABLED=false
SUPPORTFORGE_OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
SUPPORTFORGE_SLO_AVAILABILITY_TARGET=0.99
SUPPORTFORGE_SLO_LATENCY_TARGET_MS=2000
SUPPORTFORGE_QUALITY_RECALL_AT_K=0.85
SUPPORTFORGE_QUALITY_DECISION_ACCURACY=0.95
SUPPORTFORGE_QUALITY_GROUNDED_ANSWER_RATE=0.95
SUPPORTFORGE_QUALITY_CITATION_PRECISION=0.98
SUPPORTFORGE_QUALITY_REFUSAL_ACCURACY=0.98
SUPPORTFORGE_MIGRATION_SOURCE_ROOT=data
SUPPORTFORGE_MIGRATION_MAXIMUM_FILE_BYTES=104857600
